@page
@model Shop2026.Pages.Account.LoginModel
@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card p-4 shadow-sm" style="width: 350px;">
        <h4 class="text-center mb-4">KITCHEN 2026 LOGIN</h4>
        <form method="post">
            <div class="mb-3">
                <label>Username</label>
                <input asp-for="Username" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>
            <div class="text-danger">@Html.ValidationSummary(true)</div>
            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            <hr />
            <div class="text-center">
                <p>Chưa có tài khoản?</p>
                <a asp-page="/Account/Register" class="btn btn-outline-secondary w-100">Create New Account</a>
            </div>
        </form>
    </div>
</body>